# Telecodex environment configuration example.
# Copy to .env (never commit .env) and fill in real values.

# --- Telegram ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Find yours by messaging @userinfobot or @RawDataBot.
TELEGRAM_ALLOWED_USER_IDS=replace_with_numeric_user_id

# --- Codex / OpenAI ---
CODEX_API_KEY=
OPENAI_API_KEY=

# --- Security defaults (safe for project work) ---
# Permit changes only inside the selected workspace.
CODEX_SANDBOX_MODE=workspace-write

# Approval policy: never = fully automated, no interactive prompts
CODEX_APPROVAL_POLICY=never

# Keep built-in danger-full-access profile disabled
ENABLE_UNSAFE_LAUNCH_PROFILES=false

# Disable Telegram Login widget (only local .env auth)
ENABLE_TELEGRAM_LOGIN=false

# --- Verbosity ---
TOOL_VERBOSITY=summary
